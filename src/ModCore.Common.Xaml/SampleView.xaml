<DiscordView
    xmlns="clr-namespace:ModCore.Common.Xaml;assembly=ModCore.Common.Xaml"
    xmlns:Discord="clr-namespace:ModCore.Common.Discord.Entities.Components;assembly=ModCore.Common.Discord.Entities"
>
    <Discord:ActionRow>
        <Discord:ActionRow.Components>
            <Discord:Button
                Label="I am a button, click me!"
                Style="Link"
                Url="https://github.com/Naamloos/ModCore"
            />
            <Discord:Button
                Label="I am shy. Don\'t click me :("
                Style="Danger"
                Disabled="True"
                CustomId="shy_button"
             />
            <Discord:Button
                Label="{Binding ThirdButtonText}"
                Style="Secondary"
                CustomId="button"
                Emoji="{Binding ButtonEmoji}"
            />
        </Discord:ActionRow.Components>
    </Discord:ActionRow>
</DiscordView>