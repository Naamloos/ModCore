<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>portable</DebugType>
	<EmbedAllSources>true</EmbedAllSources>
	<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
	<EnableSourceLink>true</EnableSourceLink>
	<SentryOrg>naamloos</SentryOrg>
	<SentryProject>modcore-shard</SentryProject>
	<!-- Automatically creates a release when building your application. -->
	<SentryCreateRelease>true</SentryCreateRelease>
	<!-- Automatically associates commits with the release. -->
	<SentrySetCommits>true</SentrySetCommits>
	<!-- Sends symbols to Sentry, enabling symbolication of stack traces. -->
	<SentryUploadSymbols>true</SentryUploadSymbols>
	<!-- Sends sources to Sentry, enabling display of source context. -->
	<SentryUploadSources>true</SentryUploadSources>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Modules\About\Views\AboutView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </EmbeddedResource>
    <EmbeddedResource Include="Modules\Timers\Views\ReminderView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.12.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Redis" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Sentry" Version="5.6.0" />
    <PackageReference Include="Sentry.Extensions.Logging" Version="5.6.0" />
    <PackageReference Include="Sentry.Profiling" Version="5.6.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModCore.Common.Cache\ModCore.Common.Cache.csproj" />
    <ProjectReference Include="..\ModCore.Common.Database\ModCore.Common.Database.csproj" />
    <ProjectReference Include="..\ModCore.Common.Discord.Gateway\ModCore.Common.Discord.Gateway.csproj" />
    <ProjectReference Include="..\ModCore.Common.Discord.Rest\ModCore.Common.Discord.Rest.csproj" />
    <ProjectReference Include="..\ModCore.Common.InteractionFramework\ModCore.Common.InteractionFramework.csproj" />
    <ProjectReference Include="..\ModCore.Common.SettingsHelper\ModCore.Common.SettingsHelper.csproj" />
    <ProjectReference Include="..\ModCore.Common.Xaml\ModCore.Common.Xaml.csproj" />
  </ItemGroup>

</Project>
